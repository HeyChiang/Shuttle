# =============================================================
# Shuttle — Wails v3 (Go + Vue 3 / Vite)
# 注意：build/ 是 Wails 的构建资源目录（图标、打包脚本、平台 Taskfile），
# 必须入库；下面只忽略其中的"生成产物"。
# =============================================================

# ---------- Wails / Task 构建 ----------
# Taskfile 任务缓存（checksum、.tmp）
.task/
# 编译输出目录
bin/
# Vite 前端产物（构建时嵌入 Go 二进制）
frontend/dist/
# 前端依赖
frontend/node_modules/
# AppImage 构建中间产物（官方模板自带）
build/linux/appimage/build/
# NSIS 打包时下载的 WebView2 安装器（官方模板自带）
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe

# frontend/bindings/ 由 wails3 生成，但按官方约定入库，
# 保证新克隆后可直接 npm run build，无需安装 wails3 CLI。

# ---------- 移动端生成物（含本机绝对路径，不可移植；官方模板自带） ----------
build/ios/xcode/overlay.json
build/ios/xcode/gen/
build/ios/DerivedData/
build/android/overlay.json
build/android/gen/
build/android/.gradle/
build/android/app/build/
build/android/build/

# ---------- 仓库根目录构建产物（go build 直接输出到根目录时） ----------
/*.exe
/shuttle
/shuttle-server

# ---------- Go ----------
vendor/
go.work
go.work.sum
*.test
*.out
*.log
coverage.*

# ---------- Node / 前端 ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
# 构建时从网络拉取的第三方样式
frontend/public/puppertino/

# ---------- 打包产物 ----------
*.dmg
*.pkg
*.deb
*.rpm
*.AppImage
*.apk
*.aab
*.ipa
*.msix
*.msixbundle

# ---------- 本地配置与密钥 ----------
.env
.env.*
!.env.example
# 运行期生成的主机档案与本地加密密钥（含连接凭据，不提交）
hosts.json
hosts.key

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/*
!.vscode/extensions.json
*.code-workspace
*.swp
*.swo
*~
.history/

# ---------- 操作系统 / 工具产物 ----------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
*.tmp
.screenshots/
